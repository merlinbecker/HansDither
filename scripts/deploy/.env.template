# ===========================================
# Hans Dither Backend - Deployment Umgebungsvariablen
# ===========================================
# KOPIERE DIESE DATEI NACH .env UND TRAGE DEINE DATEN EIN
# .env WIRD NICHT IN GIT EINGECHECKT!
# ===========================================

# ---------- SFTP/FTP Zugang (all-inkl.com) ----------
# Hostname (z.B. ftp.all-inkl.com oder ssh.all-inkl.com für SFTP)
SFTP_HOST=

# Benutzername (all-inkl.com Kundennummer, z.B. u123456)
SFTP_USER=

# Passwort
SFTP_PASS=

# Zielverzeichnis auf dem Server (z.B. /hans-backend/)
SFTP_PATH=/hans-backend/

# Port (22 für SFTP, 21 für FTP)
SFTP_PORT=22

# ---------- MySQL Datenbank ----------
# Hostname (z.B. mysql123.all-inkl.com)
DB_HOST=

# Datenbankname
DB_NAME=hans_sync

# Benutzername (z.B. u123456_1)
DB_USER=

# Passwort
DB_PASS=

# Port (standardmäßig 3306)
DB_PORT=3306

# ---------- Backend URL ----------
# URL unter der das Backend erreichbar ist
BACKEND_URL=https://www.hans-dither.de
