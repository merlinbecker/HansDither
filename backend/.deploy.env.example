# =============================================================================
# .deploy.env - Deployment Konfiguration (BEISPIEL)
# =============================================================================
# WICHTIG:
# 1. Kopiere diese Datei nach .deploy.env
# 2. Trage DEINE echten Zugangsdaten ein
# 3. Diese Datei NICHT ins Git committen!
#    Füge sie zum .gitignore hinzu:
#    echo ".deploy.env" >> .gitignore
# =============================================================================

# --- SFTP-Zugang (all-inkl.com) ---
# Host: normalerweise ftp.all-inkl.com
#      Falls dein Account einen speziellen Server hat, steht der im KAS
SFTP_HOST=ftp.all-inkl.com

# Dein FTP-Benutzername (aus dem KAS)
SFTP_USER=dein_ftp_benutzername

# Dein FTP-Passwort (aus dem KAS)
SFTP_PASS=dein_ftp_passwort

# Port: 21 für FTP, 22 für SFTP
SFTP_PORT=21

# --- MySQL-Datenbank ---
# Host: Bei all-inkl.com meistens 'localhost'
#      Falls anders, steht die Adresse im KAS unter MySQL-Datenbanken
DB_HOST=localhost

# Dein Datenbank-Benutzername (aus dem KAS)
DB_USER=hansdither_user

# Dein Datenbank-Passwort (aus dem KAS)
DB_PASS=dein_db_passwort_hier_eintragen

# Name deiner Datenbank (aus dem KAS)
DB_NAME=hansdither

# --- Webspace-Pfade ---
# WICHTIG (all-inkl.com): Je nach Tarif/Setup startet SSH in "/" statt im
# erwarteten Home-Verzeichnis. Verwende daher den ABSOLUTEN Webroot-Pfad.
# Prüfe im KAS unter "Webspace-Verwaltung" → "Pfade", z. B.:
#   REMOTE_ROOT=/www/htdocs/w0XXXXXX/hans-dither.de
REMOTE_ROOT=/www/htdocs/w0XXXXXX/hans-dither.de

# =============================================================================
# HINWEIS:
# Nach dem Erstellen von .deploy.env:
# 1. chmod 600 .deploy.env (Schreibrechte einschränken)
# 2. ./deploy.sh ausführen
# =============================================================================

# --- SSH-Zugang (all-inkl.com, ab Premium-Tarif) ---
# Vollautomatisches Deployment: rsync-Upload + MySQL-Provisionierung direkt
# auf dem Server. Host ist dein kasserver, z. B. w0123456.kasserver.com
# Vorher einmalig Key hinterlegen: ssh-copy-id -p 22 <user>@<host>
SSH_HOST=w0123456.kasserver.com
SSH_USER=ssh-w0123456-benutzer
SSH_PORT=22
