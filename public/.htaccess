# ===========================================
# Hans Dither Backend - .htaccess
# URL-Rewriting und Sicherheitskonfiguration
# ===========================================

# --- Sicherheitsheader ---
<IfModule mod_headers.c>
    # HTTPS erzwingen (wenn SSL verfügbar)
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CORS für Playdate-Simulator und lokale Tests
    SetEnvIf Origin "^https://www\.hans-dither\.de$" CORS=$0
    SetEnvIf Origin "^http://localhost:8000$" CORS=$0
    Header always set Access-Control-Allow-Origin "%{CORS}e" env=CORS
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "X-Session-Token, Content-Type"
    Header always set Access-Control-Allow-Credentials "true"
    
    # Cache-Control für statische Dateien
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|woff2|woff|ttf|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- URL-Rewriting ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Uploads-Verzeichnis schützen
    RewriteRule ^uploads/ - [F,L]
    
    # Logs-Verzeichnis schützen
    RewriteRule ^logs/ - [F,L]
    
    # Includes-Verzeichnis schützen
    RewriteRule ^includes/ - [F,L]
    
    # .env-Dateien blockieren
    RewriteRule \.env - [F,L]
    
    # PHP-Dateien in Uploads-Verzeichnis blockieren
    RewriteRule ^uploads/.*\.php$ - [F,L]
    
    # Standard-Routing: Alle Requests zu index.php leiten
    # (ausser bestehende Dateien und Verzeichnisse)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# --- PHP-Einstellungen ---
<IfModule mod_php.c>
    # Fehler nicht anzeigen
    php_flag display_errors off
    php_value log_errors on
    php_value error_log /path/to/error.log
    
    # Upload-Größe
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_file_uploads 20
    
    # Session-Einstellungen
    php_value session.cookie_secure 1
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Strict
</IfModule>

# --- MIME-Typen ---
<IfModule mod_mime.c>
    # PDI-Dateien
    AddType application/octet-stream .pdi
    
    # JSON-Dateien
    AddType application/json .json
    
    # PNG-Dateien
    AddType image/png .png
    
    # Standard
    AddDefaultCharset UTF-8
</IfModule>

# --- Verzeichnisschutz ---
Options -Indexes
Options +FollowSymLinks

# --- Dateizugriff ---
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
